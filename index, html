        { role: "Former Assistant Social Promotional Manager", organization: "Robotic Society of RUET", period: "2024 - 2025" },
        { role: "Former IT Secretary", organization: "Rajshahi City Association, RUET", period: "RUET" },
        { role: "Former Assistant Treasurer", organization: "MTE Career Club, RUET", period: "RUET" }
      ],
      education: [
        { degree: "B.Sc. in Mechatronics Engineering", institution: "Rajshahi University of Engineering & Technology (RUET)", period: "August 2026", result: "CGPA: 3.70 / 4.00" },
