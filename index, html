      ],
      references: [
        { name: "Md. Firoj Ali", title: "Head, Dept. of MTE, RUET", email: "firoj@mte.ruet.ac.bd", phone: "+8801722723898" },
        { name: "Sarafat Hussain Abhi", title: "Assistant Professor, Dept. of MTE, RUET", email: "abhi@mte.ruet.ac.bd", phone: "+8801782959309" }
      ]
    };

    function renderPortfolio(data) {
      document.getElementById("nav-name").textContent = data.profile.name;
      document.getElementById("hero-name").textContent = data.profile.name;
      document.getElementById("hero-tagline").textContent = data.profile.tagline;
      document.getElementById("hero-summary").textContent = data.profile.summary;
      document.getElementById("email-link").href = "mailto:" + data.profile.email;
      document.getElementById("linkedin-link").href = data.profile.linkedin;
      document.getElementById("location-badge").textContent = data.profile.location + " • " + data.profile.phone;
      document.getElementById("cv-btn").href = data.profile.cvUrl;

      document.getElementById("research-list").innerHTML = data.research.map(r => `
        <div class="card">
          <div class="mono" style="margin-bottom: 0.4rem;">${r.type} (${r.status})</div>
          <h3 style="margin-bottom: 0.5rem;">${r.title}</h3>
          <ul>${r.highlights.map(h => `<li>${h}</li>`).join("")}</ul>
          ${r.doi ? `<div style="margin-top:0.75rem;"><a href="${r.doi}" target="_blank" class="mono">View Publication (DOI) &rarr;</a></div>` : ""}
        </div>
      `).join("");

      document.getElementById("skills-grid").innerHTML = Object.entries(data.skills).map(([cat, items]) => `
        <div class="card">
          <div class="mono" style="margin-bottom: 0.75rem;">${cat}</div>
          <div>${items.map(s => `<span class="tag">${s}</span>`).join("")}</div>
        </div>
      `).join("");

      document.getElementById("projects-grid").innerHTML = data.projects.map(p => `
        <div class="card">
          <div class="mono">${p.category}</div>
          <h3 style="margin: 0.3rem 0 0.5rem;">${p.title}</h3>
          <p style="color: var(--muted); font-size: 0.9rem; margin-bottom: 0.75rem;">${p.description}</p>
          <div>${p.tech.map(t => `<span class="tag">${t}</span>`).join("")}</div>
        </div>
      `).join("");

      document.getElementById("experience-list").innerHTML = data.experience.map(e => `
        <div class="card">
          <h3>${e.role}</h3>
          <div class="mono" style="margin-bottom: 0.5rem;">${e.company} &bull; ${e.period}</div>
          <ul>${e.highlights.map(h => `<li>${h}</li>`).join("")}</ul>
        </div>
      `).join("");

      document.getElementById("leadership-list").innerHTML = data.leadership.map(l => `
        <div class="card" style="padding: 1rem;">
          <h4>${l.role}</h4>
          <p style="color: var(--muted); font-size: 0.85rem;">${l.organization} (${l.period})</p>
        </div>
      `).join("");

      document.getElementById("education-list").innerHTML = data.education.map(ed => `
        <div class="card" style="padding: 1rem;">
          <h4>${ed.degree}</h4>
          <p style="color: var(--muted); font-size: 0.85rem;">${ed.institution} (${ed.period})</p>
          <div class="mono" style="margin-top: 0.25rem;">${ed.result}</div>
        </div>
      `).join("");

      document.getElementById("references-list").innerHTML = data.references.map(ref => `
        <div class="card" style="padding: 1rem;">
          <h4>${ref.name}</h4>
          <p style="color: var(--muted); font-size: 0.85rem;">${ref.title}</p>
          <div class="mono" style="margin-top: 0.25rem;">${ref.email} | ${ref.phone}</div>
        </div>
      `).join("");
    }

    async function init() {
      renderPortfolio(FALLBACK_DATA);
      if (DRIVE_API_URL && DRIVE_API_URL !== "YOUR_GOOGLE_APPS_SCRIPT_WEB_APP_URL") {
        try {
          const res = await fetch(DRIVE_API_URL);
          const liveData = await res.json();
          renderPortfolio(liveData);
        } catch (err) {
          console.warn("Using fallback CV data:", err);
        }
      }
    }
    init();
  </script>
</body>
</html>

