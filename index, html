      },
      projects: [
        { title: "AI-Based Traffic Monitoring System", category: "Computer Vision", description: "YOLO-based vehicle detection, ALPR, and speed estimation system using OpenCV and PaddleOCR.", tech: ["Python", "YOLO", "OpenCV", "PaddleOCR"] },
