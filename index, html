<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Md. Ohidul Islam | Mechatronics Engineering Portfolio</title>
  <style>
    :root {
      --bg: #020617;
      --card: #0f172a;
      --border: #1e293b;
      --text: #f1f5f9;
      --muted: #94a3b8;
      --accent: #22d3ee;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg); color: var(--text); font-family: system-ui, -apple-system, sans-serif; line-height: 1.6; }
    a { color: inherit; text-decoration: none; }
    .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
    header { position: sticky; top: 0; background: rgba(2, 6, 23, 0.9); backdrop-filter: blur(8px); border-bottom: 1px solid var(--border); z-index: 50; }
    .nav-bar { display: flex; justify-content: space-between; align-items: center; padding: 1rem 0; }
    .brand { font-size: 1.25rem; font-weight: 700; color: var(--accent); }
    .nav-links { display: flex; gap: 1.5rem; font-size: 0.9rem; color: var(--muted); }
    .nav-links a:hover { color: var(--accent); }
    .btn { background: var(--accent); color: #020617; padding: 0.5rem 1rem; border-radius: 0.5rem; font-weight: 600; font-size: 0.875rem; display: inline-block; }
    .btn-outline { background: var(--card); border: 1px solid var(--border); color: var(--text); padding: 0.6rem 1rem; border-radius: 0.5rem; font-size: 0.875rem; }
    section { padding: 3.5rem 0; border-bottom: 1px solid var(--border); }
    h1 { font-size: 3rem; font-weight: 800; margin: 0.5rem 0 1rem; }
    h2 { font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem; }
    .mono { font-family: monospace; color: var(--accent); font-size: 0.85rem; }
    .summary { color: var(--muted); max-width: 750px; margin-bottom: 1.75rem; }
    .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
    .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }
    .card { background: var(--card); border: 1px solid var(--border); border-radius: 0.75rem; padding: 1.5rem; }
    .tag { display: inline-block; background: #1e293b; color: #e2e8f0; padding: 0.25rem 0.6rem; border-radius: 0.375rem; font-size: 0.8rem; margin: 0.2rem; }
    ul { padding-left: 1.2rem; color: var(--muted); font-size: 0.9rem; margin-top: 0.5rem; }
    footer { text-align: center; padding: 2rem; color: var(--muted); font-size: 0.85rem; }
  </style>
</head>
<body>
  <header>
    <div class="container nav-bar">
      <a href="#" id="nav-name" class="brand">Md. Ohidul Islam</a>
      <nav class="nav-links">
        <a href="#research">Research</a>
        <a href="#skills">Skills</a>
        <a href="#projects">Projects</a>
        <a href="#experience">Experience</a>
        <a href="#education">Education</a>
      </nav>
      <a id="cv-btn" href="#" target="_blank" class="btn">View CV</a>
    </div>
  </header>

  <main class="container">
    <section>
      <p class="mono">B.Sc. in Mechatronics Engineering (RUET)</p>
      <h1 id="hero-name">Md. Ohidul Islam</h1>
      <p id="hero-tagline" style="font-size: 1.2rem; margin-bottom: 1rem;"></p>
      <p id="hero-summary" class="summary"></p>
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a id="email-link" href="#" class="btn-outline">Email Me</a>
        <a id="linkedin-link" href="#" target="_blank" class="btn-outline">LinkedIn</a>
        <span id="location-badge" class="btn-outline" style="color: var(--muted);"></span>
      </div>
    </section>

    <section id="research">
      <h2><span class="mono">01.</span> Research & Publications</h2>
      <div id="research-list" class="grid-2"></div>
    </section>

    <section id="skills">
      <h2><span class="mono">02.</span> Technical Skills</h2>
      <div id="skills-grid" class="grid-2"></div>
    </section>

    <section id="projects">
      <h2><span class="mono">03.</span> Featured Projects</h2>
      <div id="projects-grid" class="grid-3"></div>
    </section>

    <section id="experience">
      <div class="grid-2">
        <div>
          <h2><span class="mono">04.</span> Industrial Experience</h2>
          <div id="experience-list"></div>
        </div>
        <div>
          <h2><span class="mono">05.</span> Leadership & Activities</h2>
          <div id="leadership-list" style="display: grid; gap: 1rem;"></div>
        </div>
      </div>
    </section>

    <section id="education">
      <div class="grid-2">
        <div>
          <h2><span class="mono">06.</span> Education</h2>
          <div id="education-list" style="display: grid; gap: 1rem;"></div>
        </div>
        <div>
          <h2><span class="mono">07.</span> References</h2>
          <div id="references-list" style="display: grid; gap: 1rem;"></div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    Powered by Google Drive Headless Storage &bull; Md. Ohidul Islam
  </footer>

